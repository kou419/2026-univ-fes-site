---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import { imageUrl, withBase } from '../../utils/paths';
import { youtubeUrl } from '../../utils/youtube';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map((game) => ({ params: { id: game.id }, props: { game } }));
}

const { game } = Astro.props as { game: CollectionEntry<'games'> };
const { Content } = await render(game);
const { title, tagline, summary, genre, cover, video, screenshots, accent, event, links } = game.data;
const youtubeId = video?.match(youtubeUrl)?.[1];
const hasEvent = !!event && !!(event.playTimeMinutes || event.players || event.controls.length || event.notes);
---
<BaseLayout title={`${title} | ${site.name}`} description={summary}>
  <div class="container section">
    <a href={withBase('/#games')} class="btn btn--text">← ゲーム一覧</a>
    <div class={`detail-media tone-${accent}`}>
      {youtubeId ? (
        <iframe src={`https://www.youtube-nocookie.com/embed/${youtubeId}`} title={`${title}の動画`} allow="encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>
      ) : cover ? <img src={imageUrl(cover)} alt={`${title}のキービジュアル`} /> : <span aria-hidden="true">{title}</span>}
    </div>
    <div class="detail-layout">
      <div>
        {genre && <span class="chip">{genre}</span>}
        <h1 class="display" style="margin-top: 16px">{title}</h1>
        {tagline && <p class="title-medium">{tagline}</p>}
        <p class="body-large">{summary}</p>
        <div class="prose"><Content /></div>
        {screenshots.length > 0 && (
          <section aria-labelledby="screenshots-heading">
            <h2 id="screenshots-heading" class="headline" style="margin-top: 24px">スクリーンショット</h2>
            <div class="screenshots">
              {screenshots.map((screenshot, i) => <a href={imageUrl(screenshot)} target="_blank" rel="noopener noreferrer"><img src={imageUrl(screenshot)} alt={`${title}のスクリーンショット ${i + 1}`} loading="lazy" /></a>)}
            </div>
          </section>
        )}
      </div>
      <aside>
        {hasEvent && (
          <section aria-labelledby="event-heading">
            <h2 id="event-heading">展示・試遊情報</h2>
            <dl class="list">
              {event?.playTimeMinutes && <div><dt>プレイ時間の目安</dt><dd>約{event.playTimeMinutes}分</dd></div>}
              {event?.players && <div><dt>プレイ人数</dt><dd>{event.players}</dd></div>}
              {event && event.controls.length > 0 && <div><dt>操作方法</dt><dd><ul>{event.controls.map((control) => <li>{control}</li>)}</ul></dd></div>}
              {event?.notes && <div><dt>補足</dt><dd class="preserve-newlines">{event.notes}</dd></div>}
            </dl>
          </section>
        )}
        {links.length > 0 && (
          <section aria-labelledby="links-heading">
            <h2 id="links-heading">関連リンク</h2>
            <div class="link-list">
              {links.map((link) => <a class="btn btn--tonal" href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>)}
            </div>
          </section>
        )}
      </aside>
    </div>
  </div>
</BaseLayout>
