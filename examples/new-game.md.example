---
# 必須項目は title と summary の2つだけ。
title: "新しいゲーム名"
summary: "このゲームがどんな作品なのか、1〜2文で紹介します。"

# 以下は任意です。不要な項目は行ごと削除できます。
tagline: "一言キャッチコピー"
genre: "アクション"
accent: "cyan" # cyan / pink / orange / violet / lime
order: 6

# 画像ファイルは public/images/new-game/ に配置。
# 画像を用意していなければ、cover と screenshots は省略可能。
cover: "/images/new-game/cover.webp"
screenshots:
  - "/images/new-game/screen-01.webp"
  - "/images/new-game/screen-02.webp"

# 学祭の展示情報。未定の項目は削除してOK。
event:
  playTimeMinutes: 10
  players: "1人"
  controls:
    - "矢印キー：移動"
    - "Space：決定"
  notes: "混雑時は交代制でご案内します。"

links:
  - label: "公式サイト"
    url: "https://example.com/"
---

